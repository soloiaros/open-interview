# Required: the interviewer runs on Claude Haiku 5.5 (fast and cheap).
ANTHROPIC_API_KEY=
BETTER_AUTH_SECRET=change-me-to-32-random-characters
AGENT_SHARED_SECRET=change-me-agent-secret

# Optional overrides. Defaults work with `npm run dev`.
# LLM_MODEL=claude-haiku-5-5
# STT_MODEL=base.en          # tiny.en is faster, small.en more accurate
# TTS_VOICE=af_heart         # any Kokoro voice
# DATABASE_URL=              # use your own Postgres instead of the embedded one
# APP_URL=http://localhost:3000
